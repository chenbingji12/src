<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="treasure_car">
  <xacro:include filename="treasure_car_properties.xacro"/>
  <xacro:include filename="treasure_car_ros2_control.xacro"/>

  <!-- Materials -->
  <material name="body_blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="imu_red">
    <color rgba="0.75 0.10 0.10 1.0"/>
  </material>

  <!--
    Frame convention:
      +X forward, +Y left, +Z up.
      base_footprint is on the ground plane; base_link is 0.15 m above it.
      The car body center is at base_link height, so wheel bottoms touch z=0.
  -->
  <link name="base_footprint"/>

  <link name="base_link"/>
  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="car_body">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <!-- Box: 0.30 (X) x 0.20 (Y) x 0.20 (Z). -->
      <inertia ixx="0.0200" ixy="0" ixz="0" iyy="0.0325" iyz="0" izz="0.0325"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>
  <joint name="car_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="car_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="IMU_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.01"/>
      </geometry>
      <material name="imu_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="IMU_1_joint" type="fixed">
    <parent link="car_body"/>
    <child link="IMU_1"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.000379" ixy="0" ixz="0" iyy="0.000379" iyz="0" izz="0.000625"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="name parent child xyz">
    <joint name="${name}" type="continuous">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="-1.57079632679 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="10.0" velocity="10.0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel_link name="left_front_wheel"/>
  <xacro:wheel_link name="left_rear_wheel"/>
  <xacro:wheel_link name="right_front_wheel"/>
  <xacro:wheel_link name="right_rear_wheel"/>

  <xacro:wheel_joint name="left_front_wheel_joint" parent="car_body" child="left_front_wheel" xyz="0.12 0.13 -0.10"/>
  <xacro:wheel_joint name="left_rear_wheel_joint" parent="car_body" child="left_rear_wheel" xyz="-0.12 0.13 -0.10"/>
  <xacro:wheel_joint name="right_front_wheel_joint" parent="car_body" child="right_front_wheel" xyz="0.12 -0.13 -0.10"/>
  <xacro:wheel_joint name="right_rear_wheel_joint" parent="car_body" child="right_rear_wheel" xyz="-0.12 -0.13 -0.10"/>

  <gazebo reference="IMU_1">
    <sensor name="IMU_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <imu/>
    </sensor>
  </gazebo>
</robot>
