    <child link="ld06_lidar" />
  </joint>
  <joint name="left_behind_wheel_joint" type="continuous">
    <origin xyz="-0.12 0.13 -0.1" rpy="0 0 0" />
    <parent link="car_body" />
    <child link="left_behind_wheel" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="7.959" lower="0" upper="0" />
  </joint>
  <joint name="left_front_wheel_joint" type="continuous">
