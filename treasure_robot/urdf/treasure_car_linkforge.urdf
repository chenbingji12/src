      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <parameters>/home/cbj/ros2_ws/install/treasure_robot/share/treasure_robot/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <gazebo reference="IMU_1">
    <sensor name="IMU_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <imu />
    </sensor>
  </gazebo>
  <gazebo reference="car_body">
    <sensor name="front_line_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>/camera/image_raw</topic>
      <pose>0.15 0 0 0 1.134464 0</pose>
      <camera>
        <horizontal_fov>1.745329</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="ld06_lidar">
    <sensor name="ld06_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <gz_frame_id>ld06_lidar</gz_frame_id>
    </sensor>
  </gazebo>
</robot>